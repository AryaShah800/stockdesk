@model IReadOnlyList<LowStockAlert>
@inject ShopClock Clock
@{
    ViewData["Title"] = "Low-stock alerts";
}
<h1 class="h3 mb-3">Low-stock alerts</h1>
<p class="text-muted small">Raised by the database trigger when a sale leaves a product at or below its reorder level. One open alert per product.</p>
@if (Model.Count == 0)
{
    <p>No open alerts.</p>
}
else
{
    <table class="table align-middle" id="alerts">
        <thead><tr><th>Product</th><th>Raised</th><th class="text-end">Stock at alert</th><th class="text-end">Reorder level</th><th class="text-end">In stock now</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><a asp-controller="Products" asp-action="Details" asp-route-id="@a.ProductId">@a.Product?.Name</a></td>
                    <td>@Clock.ToLocal(a.RaisedAtUtc).ToString("dd MMM yyyy HH:mm")</td>
                    <td class="text-end">@a.QuantityAtAlert</td>
                    <td class="text-end">@a.ReorderLevel</td>
                    <td class="text-end">@a.Product?.QuantityInStock</td>
                    <td class="text-end">
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <form asp-action="Acknowledge" asp-route-id="@a.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Acknowledge</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
