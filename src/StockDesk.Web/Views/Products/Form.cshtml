@model ProductFormViewModel
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Edit product" : "Add product";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Sku" class="form-label">SKU</label>
            @if (editing)
            {
                <input class="form-control" value="@Model.Sku" disabled />
            }
            else
            {
                <input asp-for="Sku" class="form-control" />
                <span asp-validation-for="Sku" class="text-danger"></span>
            }
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="0">Choose a category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select">
                <option value="">None</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="CostPrice" class="form-label"></label>
            <input asp-for="CostPrice" class="form-control" step="0.01" min="0" />
            <span asp-validation-for="CostPrice" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitPrice" class="form-label"></label>
            <input asp-for="UnitPrice" class="form-control" step="0.01" min="0.01" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="OpeningStock" class="form-label">@(editing ? "In stock" : "Opening stock")</label>
            @if (editing)
            {
                <input class="form-control" value="@Model.OpeningStock" disabled />
                <div class="form-text">Use Restock on the product page.</div>
            }
            else
            {
                <input asp-for="OpeningStock" class="form-control" min="0" />
                <span asp-validation-for="OpeningStock" class="text-danger"></span>
            }
        </div>
        <div class="col-md-3">
            <label asp-for="ReorderLevel" class="form-label"></label>
            <input asp-for="ReorderLevel" class="form-control" min="0" />
            <span asp-validation-for="ReorderLevel" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
