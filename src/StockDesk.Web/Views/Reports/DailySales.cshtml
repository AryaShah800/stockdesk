@model DailySalesViewModel
@{
    ViewData["Title"] = "Daily sales";
}
<h1 class="h3 mb-3">Daily sales</h1>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="from" class="form-label">From</label>
        <input type="date" id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="to" class="form-label">To</label>
        <input type="date" id="to" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Show</button></div>
</form>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<p class="text-muted small">From the <code>usp_DailySales</code> stored procedure. Days are in the shop's time zone.</p>
<table class="table" id="daily-sales">
    <thead><tr><th>Date</th><th class="text-end">Bills</th><th class="text-end">Items sold</th><th class="text-end">Revenue</th></tr></thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.SaleDate.ToString("ddd dd MMM yyyy")</td>
                <td class="text-end">@row.Bills</td>
                <td class="text-end">@row.ItemsSold</td>
                <td class="text-end">₹@row.Revenue.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th>Total</th>
            <th class="text-end">@Model.Rows.Sum(r => r.Bills)</th>
            <th class="text-end">@Model.Rows.Sum(r => r.ItemsSold)</th>
            <th class="text-end">₹@Model.Rows.Sum(r => r.Revenue).ToString("N2")</th>
        </tr>
    </tfoot>
</table>
@if (Model.Rows.Count == 0)
{
    <p class="text-muted">No sales in this range.</p>
}
