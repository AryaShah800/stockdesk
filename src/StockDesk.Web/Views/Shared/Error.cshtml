@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<h1 class="text-danger">Something went wrong.</h1>
<p>The request could not be completed. Try again, and tell your administrator if it keeps happening.</p>
@if (!string.IsNullOrEmpty(Model?.RequestId))
{
    <p class="text-muted small">Request id: <code>@Model.RequestId</code></p>
}
